<link rel="stylesheet" href="css/login.css">
<link rel="stylesheet" href="css/form.css">
<link rel="stylesheet" href="css/reset-password.css">

<div id="form-wrapper">
    <form id="form-reset-password" class="form-container" method="post">
        <h2 id="form-header">Reset Your Password</h2>
        <p class="form-description">Enter your new password below.</p>
        
        <div class="mb-3">
            <input class="form-control form-control-lg" id="input-new-password" name="newPassword" type="password" placeholder="New Password" required>
        </div>
        
        <div class="mb-3">
            <input class="form-control form-control-lg" id="input-confirm-password" name="confirmPassword" type="password" placeholder="Confirm New Password" required>
        </div>
        
        <div class="error-msg" id="reset-error-msg" data-error-status="{{#if (isDefined error)}}error{{else}}normal{{/if}}">{{error}}</div>
        
        {{#if success}}
        <div class="error-msg" id="reset-success-msg" data-error-status="success">{{success}}</div>
        {{/if}}
        
        <div id="password-requirements">
            <p>Password must:</p>
            <ul>
                <li id="length-req">Be at least 8 characters long</li>
                <li id="uppercase-req">Contain at least one uppercase letter</li>
                <li id="lowercase-req">Contain at least one lowercase letter</li>
                <li id="number-req">Contain at least one number</li>
            </ul>
        </div>
        
        <div id="last-row">
            {{#if isEmployee}}
            <a href="/employee" id="form-switch-link">Back to Employee Login</a>
            {{else}}
            <a href="/login" id="form-switch-link">Back to Login</a>
            {{/if}}
            <button class="btn" id="btn-submit" type="submit">Reset Password</button>
        </div>
        
        <!-- Hidden field for the reset token -->
        <input type="hidden" name="token" value="{{token}}">
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const newPasswordInput = document.getElementById('input-new-password');
    const confirmPasswordInput = document.getElementById('input-confirm-password');
    const errorMsg = document.getElementById('reset-error-msg');
    const form = document.getElementById('form-reset-password');
    
    // Password requirements elements
    const lengthReq = document.getElementById('length-req');
    const uppercaseReq = document.getElementById('uppercase-req');
    const lowercaseReq = document.getElementById('lowercase-req');
    const numberReq = document.getElementById('number-req');
    
    // Real-time password validation
    newPasswordInput.addEventListener('input', function() {
        const password = this.value;
        
        // Check length
        if (password.length >= 8) {
            lengthReq.style.color = 'green';
            lengthReq.style.textDecoration = 'line-through';
        } else {
            lengthReq.style.color = 'red';
            lengthReq.style.textDecoration = 'none';
        }
        
        // Check uppercase
        if (/[A-Z]/.test(password)) {
            uppercaseReq.style.color = 'green';
            uppercaseReq.style.textDecoration = 'line-through';
        } else {
            uppercaseReq.style.color = 'red';
            uppercaseReq.style.textDecoration = 'none';
        }
        
        // Check lowercase
        if (/[a-z]/.test(password)) {
            lowercaseReq.style.color = 'green';
            lowercaseReq.style.textDecoration = 'line-through';
        } else {
            lowercaseReq.style.color = 'red';
            lowercaseReq.style.textDecoration = 'none';
        }
        
        // Check number
        if (/[0-9]/.test(password)) {
            numberReq.style.color = 'green';
            numberReq.style.textDecoration = 'line-through';
        } else {
            numberReq.style.color = 'red';
            numberReq.style.textDecoration = 'none';
        }
    });
    
    // Real-time password confirmation validation
    confirmPasswordInput.addEventListener('input', function() {
        const password = newPasswordInput.value;
        const confirmPassword = this.value;
        
        if (confirmPassword && password !== confirmPassword) {
            this.style.borderColor = 'red';
        } else {
            this.style.borderColor = '';
        }
    });
    
    // Form submission validation
    form.addEventListener('submit', function(e) {
        const password = newPasswordInput.value;
        const confirmPassword = confirmPasswordInput.value;
        
        // Clear previous errors
        errorMsg.setAttribute('data-error-status', 'normal');
        errorMsg.textContent = '';
        
        // Validate password requirements
        if (password.length < 8) {
            e.preventDefault();
            errorMsg.setAttribute('data-error-status', 'error');
            errorMsg.textContent = 'Password must be at least 8 characters long.';
            return;
        }
        
        if (!/[A-Z]/.test(password)) {
            e.preventDefault();
            errorMsg.setAttribute('data-error-status', 'error');
            errorMsg.textContent = 'Password must contain at least one uppercase letter.';
            return;
        }
        
        if (!/[a-z]/.test(password)) {
            e.preventDefault();
            errorMsg.setAttribute('data-error-status', 'error');
            errorMsg.textContent = 'Password must contain at least one lowercase letter.';
            return;
        }
        
        if (!/[0-9]/.test(password)) {
            e.preventDefault();
            errorMsg.setAttribute('data-error-status', 'error');
            errorMsg.textContent = 'Password must contain at least one number.';
            return;
        }
        
        // Validate password confirmation
        if (password !== confirmPassword) {
            e.preventDefault();
            errorMsg.setAttribute('data-error-status', 'error');
            errorMsg.textContent = 'Passwords do not match.';
            return;
        }
    });
});
</script>
