<link rel="stylesheet" href="/css/form.css">
<link rel="stylesheet" href="/css/bs-form-override.css">
<link rel="stylesheet" href="/css/customer-settings.css">
<link rel="stylesheet" href="/css/modal.css">

<script src="/js/snackbar.js" type="module"></script>
<script src="/js/admin-settings.js" type="module"></script>

<div id="settings-wrapper" class="row g-0 bg-noise-pattern">
    <div class="col-5" id="settings-header-container">
        <h2 id="settings-header">Admin<br />Settings</h2>
    </div>
    <div class="col-7" id="settings-container">
        <div id="settings-form-container">
            <form method="POST" action="/admin/settings" id="form-admin-settings">
                <input type="hidden" id="input-settings-admin-id" name="admin_id" value="{{logged_in.user.id}}">
                
                <!-- Basic Information Section -->
                <div class="mb-4" id="basic-info-section">
                    <h5 class="section-title">Basic Information</h5>
                    <div class="mb-3">
                        <label for="input-settings-admin-username" class="form-label">Username</label>
                        <input type="text" id="input-settings-admin-username" name="username" class="form-control" value="{{logged_in.user.username}}">
                    </div>
                </div>
                
                <!-- Password Change Section -->
                <div class="mb-4" id="password-change-section">
                    <h5 class="section-title">Password</h5>
                    <p class="section-description">To change your password, you'll need to verify your identity through security questions.</p>
                    <button type="button" class="btn btn-outline-primary" id="change-password-btn">
                        <i class="fa fa-key"></i> Change Password
                    </button>
                </div>

                <!-- Security Questions Section -->
                <div class="mb-4" id="security-questions-section">
                    <h5 class="section-title">Security Questions</h5>
                    <p class="section-description">Set up security questions to help recover your account if you forget your password.</p>
                    <button type="button" class="btn btn-outline-secondary" id="change-security-questions-btn">
                        <i class="fa fa-question-circle"></i> Manage Security Questions
                    </button>
                </div>

                <div class="error-msg" id="form-admin-settings-error" data-error-status="normal"></div>
                
                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary" id="save-settings-btn">
                        <i class="fa fa-save"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Security Questions Modal for Password Change -->
<div id="security-question-modal" class="modal" style="display: none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Security Questions</h5>
                <button type="button" class="btn-close" id="close-security-modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Answer your security questions to verify your identity:</p>
                <div id="question1-container" style="display: none;">
                    <div class="mb-3">
                        <label id="security-question1-text" class="form-label"></label>
                        <input type="text" id="security-answer1" placeholder="Your answer" class="form-control">
                    </div>
                </div>
                <div id="question2-container" style="display: none;">
                    <div class="mb-3">
                        <label id="security-question2-text" class="form-label"></label>
                        <input type="text" id="security-answer2" placeholder="Your answer" class="form-control">
                    </div>
                </div>
                <div id="security-error" class="error-msg" data-error-status="normal"></div>
            </div>
            <div class="modal-footer">
                <button type="button" id="cancel-security" class="btn btn-discard"><i class="fa fa-times"></i>Cancel</button>
                <button type="button" id="submit-security-answers" class="btn btn-modal-success"><i class="fa fa-check"></i>Verify</button>
            </div>
        </div>
    </div>
</div>

<!-- New Password Modal -->
<div id="new-password-modal" class="modal" style="display: none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Change Password</h5>
                <button type="button" class="btn-close" id="close-password-modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="new-password" class="form-label">New Password</label>
                    <input type="password" id="new-password" class="form-control" placeholder="Enter new password">
                </div>
                <div class="mb-3">
                    <label for="confirm-password" class="form-label">Confirm New Password</label>
                    <input type="password" id="confirm-password" class="form-control" placeholder="Confirm new password">
                </div>
                <div id="password-requirements">
                    <p class="small text-muted">Password must meet the following requirements:</p>
                    <ul class="small text-muted">
                        <li id="length-req">At least 8 characters long</li>
                        <li id="uppercase-req">Contains at least one uppercase letter</li>
                        <li id="lowercase-req">Contains at least one lowercase letter</li>
                        <li id="number-req">Contains at least one number</li>
                    </ul>
                </div>
                <div id="password-error" class="error-msg" data-error-status="normal"></div>
            </div>
            <div class="modal-footer">
                <button type="button" id="cancel-password" class="btn btn-discard"><i class="fa fa-times"></i>Cancel</button>
                <button type="button" id="submit-new-password" class="btn btn-modal-success"><i class="fa fa-check"></i>Update Password</button>
            </div>
        </div>
    </div>
</div>

<!-- Change Security Questions Modal -->
<div class="modal" id="change-security-questions-modal" style="display: none;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Security Questions</h5>
                <button type="button" class="btn-close" id="close-change-security-modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Set up security questions to help recover your account if you forget your password.</p>
                
                <form id="security-questions-form">
                    <div class="mb-3">
                        <label for="security-question-1" class="form-label">Security Question 1</label>
                        <select id="security-question-1" name="question1" class="form-select">
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="security-answer-1" class="form-label">Answer 1</label>
                        <input type="text" id="security-answer-1" name="answer1" class="form-control" placeholder="Enter your answer">
                    </div>
                    
                    <div class="mb-3">
                        <label for="security-question-2" class="form-label">Security Question 2</label>
                        <select id="security-question-2" name="question2" class="form-select">
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="security-answer-2" class="form-label">Answer 2</label>
                        <input type="text" id="security-answer-2" name="answer2" class="form-control" placeholder="Enter your answer">
                    </div>
                </form>
                
                <div id="security-questions-error" class="error-msg" data-error-status="normal"></div>
            </div>
            <div class="modal-footer">
                <button type="button" id="cancel-security-questions" class="btn btn-discard"><i class="fa fa-times"></i>Cancel</button>
                <button type="button" id="save-security-questions" class="btn btn-modal-success"><i class="fa fa-save"></i>Save Questions</button>
            </div>
        </div>
    </div>
</div>
