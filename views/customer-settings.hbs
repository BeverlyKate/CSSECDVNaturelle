<link rel="stylesheet" href="/css/form.css">
<link rel="stylesheet" href="/css/bs-form-override.css">
<link rel="stylesheet" href="/css/customer-settings.css">

<script src="/js/snackbar.js" type="module"></script>
<script src="/js/customer-settings.js" type="module"></script>

<script>
// No additional JavaScript needed for basic form functionality
</script>

<div id="settings-wrapper" class="row g-0 bg-noise-pattern">
    <div class="col-5" id="settings-header-container">
        <h2 id="settings-header">Profile<br />Settings</h2>
    </div>
    <div class="col-7" id="settings-container">
        <div id="settings-form-container">
            <form method="POST" action="/settings" id="form-customer-settings">
                <input type="hidden" id="input-settings-customer-id" name="customer_id" value="{{logged_in.user.id}}">
                <div class="row mb-3">
                    <div class="col">
                        <label for="input-settings-customer-fname" class="form-label">First Name</label>
                        <input type="text" id="input-settings-customer-fname" name="customer_fname" class="form-control" value="{{logged_in.user.firstName}}">
                    </div>
                    <div class="col">
                        <label for="input-settings-customer-lname" class="form-label">Last Name</label>
                        <input type="text" id="input-settings-customer-lname" name="customer_lname" class="form-control" value="{{logged_in.user.lastName}}">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="input-settings-customer-email" class="form-label">Email Address</label>
                    <input type="text" id="input-settings-customer-email" name="customer_email" class="form-control" value="{{logged_in.user.email}}">
                </div>
                <div class="mb-3">
                    <label for="input-settings-customer-contact" class="form-label">Contact Number</label>
                    <input type="text" id="input-settings-customer-contact" name="customer_contact" class="form-control" value="{{logged_in.user.contactNumber}}">
                </div>
                
                <!-- Password Change Section -->
                <div class="mb-4" id="password-change-section">
                    <h5 class="section-title">Password</h5>
                    <p class="section-description">To change your password, you'll need to verify your identity through security questions.</p>
                    <button type="button" class="btn btn-outline-primary" id="change-password-btn">
                        <i class="fa fa-key"></i> Change Password
                    </button>
                </div>

                <!-- Security Questions Section -->
                <div class="mb-4" id="security-questions-section">
                    <h5 class="section-title">Security Questions</h5>
                    <p class="section-description">Update your security questions to ensure account security.</p>
                    <button type="button" class="btn btn-outline-secondary" id="change-security-questions-btn" data-bs-toggle="modal" data-bs-target="#change-security-questions-modal">
                        <i class="fa fa-shield-alt"></i> Change Security Questions
                    </button>
                </div>
                
                <div class="row mb-3" style="display: none;">
                    <div class="col">
                        <label for="input-settings-customer-current-password" class="form-label">Current Password</label>
                        <input type="password" id="input-settings-customer-old-password" name="old_password" class="form-control">
                    </div>
                    <div class="col">
                        <label for="input-settings-customer-new-password" class="form-label">New Password</label>
                        <input type="password" id="input-settings-customer-new-password" name="new_password" class="form-control" placeholder="* Only if you want to change your password.">
                    </div>
                </div>
            </form>
            <div class="error-msg" id="form-customer-settings-error" data-error-status="normal"></div>
            <div id="settings-footer">
                <div id="form-password-notice">Update your profile information and save changes.</div>
                <button type="submit" class="btn" id="customer-save-settings-btn" form="form-customer-settings"><i class="fa fa-check"></i>Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Security Questions Modal for Password Change -->
<div id="security-question-modal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h4>Verify Identity</h4>
            <span class="close" id="close-security-modal">&times;</span>
        </div>
        <div class="modal-body">
            <p>Please answer your security questions to change your password:</p>
            <div id="security-questions-container">
                <!-- Security questions will be loaded here -->
            </div>
            <div id="security-error" class="error-msg" data-error-status="normal"></div>
        </div>
        <div class="modal-footer">
            <button type="button" id="submit-security-answers" class="btn btn-primary">Verify</button>
            <button type="button" id="cancel-security" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
</div>

<!-- New Password Modal -->
<div id="new-password-modal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h4>Set New Password</h4>
            <span class="close" id="close-password-modal">&times;</span>
        </div>
        <div class="modal-body">
            <p>Enter your new password:</p>
            <div class="mb-3">
                <label for="new-password-input" class="form-label">New Password</label>
                <input type="password" id="new-password-input" class="form-control" placeholder="Enter new password">
            </div>
            <div class="mb-3">
                <label for="confirm-password-input" class="form-label">Confirm Password</label>
                <input type="password" id="confirm-password-input" class="form-control" placeholder="Confirm new password">
            </div>
            <div id="password-requirements">
                <p>Password must meet the following requirements:</p>
                <ul>
                    <li id="length-req">At least 8 characters long</li>
                    <li id="uppercase-req">Contains at least one uppercase letter</li>
                    <li id="lowercase-req">Contains at least one lowercase letter</li>
                    <li id="number-req">Contains at least one number</li>
                </ul>
            </div>
            <div id="password-error" class="error-msg" data-error-status="normal"></div>
        </div>
        <div class="modal-footer">
            <button type="button" id="submit-new-password" class="btn btn-primary">Change Password</button>
            <button type="button" id="cancel-password" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
</div>

<!-- Change Security Questions Modal -->
<div class="modal modal-md fade" id="change-security-questions-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Change Security Questions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="form-security-questions-change">
                    <p>Please set up or update your security questions:</p>
                    <div class="alert alert-info" id="security-questions-info" style="display: none;">
                        <small><i class="fa fa-info-circle"></i> Your current security questions have been loaded. You can modify them or keep them the same by re-entering your answers.</small>
                    </div>
                    
                    <div class="mb-3">
                        <label for="security-question-1" class="form-label">Security Question 1</label>
                        <select id="security-question-1" class="form-control">
                            <option value="">Select a question</option>
                            <option value="What was the name of your first pet?">What was the name of your first pet?</option>
                            <option value="What is your favorite childhood game?">What is your favorite childhood game?</option>
                            <option value="What city were you born in?">What city were you born in?</option>
                            <option value="What was the name of your elementary school?">What was the name of your elementary school?</option>
                            <option value="What is your favorite food?">What is your favorite food?</option>
                            <option value="What was your childhood nickname?">What was your childhood nickname?</option>
                            <option value="What is your motto in life?">What is your motto in life?</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="security-answer-1" class="form-label">Answer 1</label>
                        <input type="text" id="security-answer-1" class="form-control" placeholder="Enter your answer">
                    </div>

                    <div class="mb-3">
                        <label for="security-question-2" class="form-label">Security Question 2</label>
                        <select id="security-question-2z" class="form-control">
                            <option value="">Select a question</option>
                            <option value="What was the name of your first pet?">What was the name of your first pet?</option>
                            <option value="What is your favorite childhood game?">What is your favorite childhood game?</option>
                            <option value="What city were you born in?">What city were you born in?</option>
                            <option value="What was the name of your elementary school?">What was the name of your elementary school?</option>
                            <option value="What is your favorite food?">What is your favorite food?</option>
                            <option value="What was your childhood nickname?">What was your childhood nickname?</option>
                            <option value="What is your motto in life?">What is your motto in life?</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="security-answer-2" class="form-label">Answer 2</label>
                        <input type="text" id="security-answer-2" class="form-control" placeholder="Enter your answer">
                    </div>

                    <div id="change-security-error" class="error-msg" data-error-status="normal"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-discard" data-bs-dismiss="modal"><i class="fa fa-trash"></i>Discard</button>
                <button type="submit" class="btn btn-modal-success" form="form-security-questions-change"><i class="fa fa-check"></i>Save Security Questions</button>
            </div>
        </div>
    </div>
</div>