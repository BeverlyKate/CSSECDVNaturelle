<link rel="stylesheet" href="/css/admin-dashboard.css">

<div class="admin-wrapper">
    <div class="admin-header-wrapper">
        <div class="admin-header-container">
            <h2 class="admin-header"><i class="fa fa-solid fa-home"></i>Admin Dashboard</h2>
        </div>
    </div>
    <div id="admin-container">
        <div id="tools-container">
            <a href="/admin/reservations" class="tool-btn">
                <div class="tool-btn-header-container">
                    <div class="tool-btn-header">Reservations</div>
                    <i class="fa fa-solid fa-sticky-note"></i>
                </div>
                <div class="tool-count">{{reservations_count}}</div>
            </a>
            <a href="/admin/services" class="tool-btn">
                <div class="tool-btn-header-container">
                    <div class="tool-btn-header">Services</div>
                    <i class="fa fa-solid fa-spa"></i>
                </div>
                <div class="tool-count">{{services_count}}</div>
            </a>
            <a href="/admin/employees" class="tool-btn">
                <div class="tool-btn-header-container">
                    <div class="tool-btn-header">Employees</div>
                    <i class="fa fa-solid fa-users-cog"></i>
                </div>
                <div class="tool-count">{{employees_count}}</div>
            </a>
            <a href="/admin/faq" class="tool-btn">
                <div class="tool-btn-header-container">
                    <div class="tool-btn-header">FAQ</div>
                    <i class="fa fa-solid fa-question-circle"></i>
                </div>
                <div class="tool-count">{{faq_count}}</div>
            </a>
        </div>
        <div id="last-login-container">
            <div id="last-login-success-container">
                <div class="last-login-icon-container">
                    <i class="fa fa-solid fa-user-check"></i>
                </div>
                <div class="last-login-details-container">
                    <div class="last-login-details-header">Last successful login</div>
                    <div class="last-login-details-info">{{formatDate logged_in.user.lastLogin}}</div>
                </div>
            </div>
            <div id="last-login-fail-container">
                <div class="last-login-icon-container">
                    <i class="fa fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="last-login-details-container">
                    <div class="last-login-details-header">Last unsuccessful login</div>
                    <div class="last-login-details-info">{{formatDate logged_in.user.lastFailedLogin}}</div>
                </div>
            </div>
        </div>
        <div id="logs-wrapper">
            <div id="logs-header-container">
                <h3 id="logs-header"><i class="fa fa-solid fa-clock-rotate-left"></i>Recent Logs</h3>
                <a href="/admin/logs" class="btn btn-view-logs" id="btn-view-logs">View more logs<i class="fa fa-solid fa-chevron-right me-0 ms-2"></i></a>
                <a href="/admin/logs" class="btn btn-view-logs" id="btn-view-logs-mobile">View more<i class="fa fa-solid fa-chevron-right me-0 ms-2"></i></a>
            </div>
            <div id="logs-notice-container">
                <div id="logs-notice">This section only shows the 3 most recent logs per category.  Some columns are hidden.  To view the full data, click the button above.</div>
            </div>
            <div id="logs-container">
                <div id="logs-tabs-container">
                    <ul class="nav nav-pills">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#logs-inputvalidation" type="button" role="tab">Input Validation failures</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#logs-authattempts" type="button" role="tab">Authentication Attempts</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#logs-accesscontrol" type="button" role="tab">Access Control failures</button>
                        </li>
                    </ul>
                </div>
                <div id="logs-list-container" class="tab-content">
                    <div id="logs-inputvalidation" class="log-container tab-pane fade show active table-responsive" role="tabpanel">
                        <table class="table">
                            <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>User</th>
                                <th>Endpoint</th>
                                <th>Field Name</th>
                                <th>Validation Rule</th>
                            </tr>
                            </thead>
                            <tbody>
                                {{#each logs_inputvalidation_recent}}
                                    <tr>
                                        <td>{{this.timestamp}}</td>
                                        <td>{{this.userId}}</td>
                                        <td><code>{{this.endpoint}}</code></td>
                                        <td><code>{{this.fieldName}}</code></td>
                                        <td><code>{{this.validationRule}}</code></td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                    <div id="logs-authattempts" class="log-container tab-pane fade table-responsive" role="tabpanel">
                        <table class="table">
                            <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>User</th>
                                <th>Status</th>
                                <th>User Type</th>
                                <th>Endpoint</th>
                                <th>Attempt Type</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{#each logs_authattempts_recent}}
                                <tr>
                                    <td>{{this.timestamp}}</td>
                                    <td>{{this.user}}</td>
                                    <td>
                                        {{#ifEquals this.status "success"}}
                                            <span class="badge badge-status-success"><i class="fa fa-solid fa-check"></i>Success</span>
                                        {{/ifEquals}}
                                        {{#ifEquals this.status "fail"}}
                                            <span class="badge badge-status-fail"><i class="fa fa-solid fa-xmark"></i>Fail</span>
                                        {{/ifEquals}}
                                    </td>
                                    <td>
                                        {{#ifEquals this.userType "customer"}}
                                            <span class="badge badge-usertype-customer">Customer</span>
                                        {{/ifEquals}}
                                        {{#ifEquals this.userType "admin"}}
                                            <span class="badge badge-usertype-admin">Admin</span>
                                        {{/ifEquals}}
                                        {{#ifEquals this.userType "employee"}}
                                            <span class="badge badge-usertype-employee">Employee</span>
                                        {{/ifEquals}}
                                    </td>
                                    <td><code>{{this.endpoint}}</code></td>
                                    <td><code>{{this.attemptType}}</code></td>
                                </tr>
                            {{/each}}
                            </tbody>
                        </table>
                    </div>
                    <div id="logs-accesscontrol" class="log-container tab-pane fade table-responsive" role="tabpanel">
                        <table class="table">
                            <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>User</th>
                                <th>User Type</th>
                                <th>Endpoint</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{#each logs_accesscontrol_recent}}
                                <tr>
                                    <td>{{this.timestamp}}</td>
                                    <td>{{this.userId}}</td>
                                    <td>
                                        {{#ifEquals this.userType "customer"}}
                                            <span class="badge badge-usertype-customer">Customer</span>
                                        {{/ifEquals}}
                                        {{#ifEquals this.userType "admin"}}
                                            <span class="badge badge-usertype-admin">Admin</span>
                                        {{/ifEquals}}
                                        {{#ifEquals this.userType "employee"}}
                                            <span class="badge badge-usertype-employee">Employee</span>
                                        {{/ifEquals}}
                                    </td>
                                    <td><code>{{this.endpoint}}</code></td>
                                </tr>
                            {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>