<link rel="stylesheet" href="/css/sidebar-employee.css">
<link rel="stylesheet" href="/css/fab.css">
<script src="/js/fab.js"></script>
<script src="/js/employee-settings.js" type="module"></script>

<div id="sidenav">
    <div id="salon-title">Salon<br/>Naturelle</div>
    <div id="sidenav-container">
        <ul class="nav">
            <div id="employee-info-container">
                <i class="fa fa-user-circle fa-2xl"></i>
                <div class="col">
                    <div id="employee-name">{{logged_in.user.employee_name}}</div>
                    <div id="employee-email">{{logged_in.user.employee_email}}</div>
                </div>
            </div>
        </ul>
    </div>
    <div id="bottom-btn-container">
        <a href="/" class="btn bottom-btn" id="customer-view-btn"><i class="fa fa-solid fa-laptop"></i>Customer View</a>
        <div id="account-tab-container">
            <button class="btn bottom-btn" id="settings-btn" data-bs-toggle="modal" data-bs-target="#modal-employee-settings-edit"><i class="fa fa-solid fa-gear"></i>Settings</button>
            <a href="/logout" class="btn bottom-btn" id="admin-logout-btn"><i class="fa fa-solid fa-right-from-bracket"></i>Log Out</a>
        </div>
    </div>
    <div id="fab-container">
        <button id="btn-fab" data-toggle="fab" data-fab-blur-target="#admin-wrapper">
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </button>
        <div id="fab-items-container">
            <a href="/" class="fab-item-group" id="customer-view-fab">
                <div class="fab-item-label">Customer View</div>
                <div class="fab-item-icon"><i class="fa fa-laptop"></i></div>
            </a>
            <a href="" class="fab-item-group" id="settings-fab">
                <div class="fab-item-label">Settings</div>
                <div class="fab-item-icon"><i class="fa fa-gear"></i></div>
            </a>
            <a href="/logout" class="fab-item-group" id="logout-fab">
                <div class="fab-item-label">Log Out</div>
                <div class="fab-item-icon"><i class="fa fa-right-from-bracket"></i></div>
            </a>
        </div>
    </div>
</div>

<div class="modal modal-lg fade" id="modal-employee-settings-edit">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Account Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="form-employee-settings">
                    <input type="hidden" id="input-settings-employee-id" name="employee_id" value="{{logged_in.user.employee_id}}">
                    <div class="row mb-3">
                        <div class="col">
                            <label for="input-settings-employee-fname" class="form-label">First Name</label>
                            <input type="text" id="input-settings-employee-fname" name="employee_fname" class="form-control" value="{{logged_in.user.employee_firstName}}">
                        </div>
                        <div class="col">
                            <label for="input-settings-employee-lname" class="form-label">Last Name</label>
                            <input type="text" id="input-settings-employee-lname" name="employee_lname" class="form-control" value="{{logged_in.user.employee_lastName}}">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="input-settings-employee-email" class="form-label">Email Address</label>
                        <input type="text" id="input-settings-employee-email" name="employee_email" class="form-control" value="{{logged_in.user.employee_email}}">
                    </div>
                    <div class="mb-3">
                        <label for="input-settings-employee-contact" class="form-label">Contact Number</label>
                        <input type="text" id="input-settings-employee-contact" name="employee_contact" class="form-control" value="{{logged_in.user.employee_contactNumber}}">
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label for="input-settings-employee-current-password" class="form-label">Current Password</label>
                            <input type="password" id="input-settings-employee-current-password" name="old_password" class="form-control">
                        </div>
                        <div class="col">
                            <label for="input-settings-employee-new-password" class="form-label">New Password</label>
                            <input type="password" id="input-settings-employee-new-password" name="new_password" class="form-control" placeholder="* Only if you want to change your password.">
                        </div>
                    </div>
                    <div id="form-password-notice">You need to enter your current password<br />to make any changes.</div>
                    <div class="error-msg" id="form-employee-settings-error" data-error-status="normal"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-discard" data-bs-dismiss="modal"><i class="fa fa-trash"></i>Discard</button>
                <button type="submit" class="btn btn-modal-success" id="employee-save-settings-btn" form="form-employee-settings"><i class="fa fa-check"></i>Save</button>
            </div>
        </div>
    </div>
</div>