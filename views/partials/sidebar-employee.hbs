<link rel="stylesheet" href="/css/sidebar-employee.css">
<link rel="stylesheet" href="/css/fab.css">
<script src="/js/fab.js"></script>
<script src="/js/employee-settings.js" type="module"></script>

<div id="sidenav">
    <div id="salon-title">Salon<br/>Naturelle</div>
    <div id="sidenav-container">
        <ul class="nav">
            <div id="employee-info-container">
                <i class="fa fa-user-circle fa-2xl"></i>
                <div class="col">
                    <div id="employee-name">{{logged_in.user.name}}</div>
                    <div id="employee-email">{{logged_in.user.email}}</div>
                </div>
            </div>
            <div id="report-info-container-successful">
                <i class="fa fa-solid fa-user-check"></i>
                <div class="col">
                    <div id="alert-successful-text">Last successful login</div>
                    <div class="flex-container">
                        <div id="alert-time">{{formatDate logged_in.user.lastLogin}}</div>
                        <a href="aa" id="alert-link">not you?</a>
                    </div>
                    {{!-- {{logged_in.user.employee_email}} --}}
                </div>
            </div>
            <div id="report-info-container-unsucessful">
                <i id="alert-icon"></i>
                <div class="col">
                    <div id="alert-unsuccessful-text">Unsucessful login</div>
                    <div class="flex-container">
                        <div id="alert-time">{{formatDate logged_in.user.lastFailedLogin}}</div>
                        <a href="aa" id="alert-link">not you?</a>
                    </div>
                </div>
            </div>
        </ul>
    </div>
    <div id="bottom-btn-container">
        <a href="/" class="btn bottom-btn" id="customer-view-btn"><i class="fa fa-solid fa-laptop"></i>Customer View</a>
        <div id="account-tab-container">
            <a href="{{#ifEquals page_context 'settings'}}/employee{{else}}/employee/settings{{/ifEquals}}" class="btn bottom-btn" id="settings-btn">
                <i class="fa fa-solid fa-{{#ifEquals page_context 'settings'}}arrow-left{{else}}gear{{/ifEquals}}"></i>
                {{#ifEquals page_context 'settings'}}Back to Reservations{{else}}Settings{{/ifEquals}}
            </a>
            <a href="/logout" class="btn bottom-btn" id="admin-logout-btn"><i class="fa fa-solid fa-right-from-bracket"></i>Log Out</a>
        </div>
    </div>
    <div id="fab-container">
        <button id="btn-fab" data-toggle="fab" data-fab-blur-target="#employee-wrapper">
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </button>
        <div id="fab-items-container">
            <a href="/" class="fab-item-group" id="customer-view-fab">
                <div class="fab-item-label">Customer View</div>
                <div class="fab-item-icon"><i class="fa fa-laptop"></i></div>
            </a>
            <a href="{{#ifEquals page_context 'settings'}}/employee{{else}}/employee/settings{{/ifEquals}}" class="fab-item-group" id="settings-fab">
                <div class="fab-item-label">{{#ifEquals page_context 'settings'}}Back to Reservations{{else}}Settings{{/ifEquals}}</div>
                <div class="fab-item-icon"><i class="fa fa-{{#ifEquals page_context 'settings'}}arrow-left{{else}}gear{{/ifEquals}}"></i></div>
            </a>
            <a href="/logout" class="fab-item-group" id="logout-fab">
                <div class="fab-item-label">Log Out</div>
                <div class="fab-item-icon"><i class="fa fa-right-from-bracket"></i></div>
            </a>
        </div>
    </div>
</div>